---
type Props = {
  title: string;
  subtitle: string;
  content: string;
}

const { title, subtitle, content } = Astro.props;
---

<section style="padding: 1rem 0.5rem; max-width: 100%; box-sizing: border-box; background: #e0e7ff; border-radius: 0.5rem; margin: 1rem 0;">
  <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">{title}</h2>
  <p style="font-size: 0.95rem; margin-bottom: 0.5rem;">{subtitle}</p>
  <p style="font-size: 0.95rem; margin-bottom: 0.5rem;">{content}</p>
</section> 