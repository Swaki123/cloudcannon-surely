---
const { title = 'Welcome to CloudCannon Surely', subtitle = 'Your journey starts here.', cta = 'Get Started' } = Astro.props;
---

<section style="padding: 4rem 2rem; text-align: center; background: #e0e7ff; border-radius: 1rem; margin: 2rem 0;">
  <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">{title}</h2>
  <p style="font-size: 1.25rem; margin-bottom: 2rem;">{subtitle}</p>
  <a href="#" style="display: inline-block; padding: 0.75rem 2rem; background: #6366f1; color: #fff; border-radius: 0.5rem; text-decoration: none; font-weight: bold;">{cta}</a>
</section> 