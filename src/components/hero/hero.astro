---
type Props = {
  title: string;
  subtitle: string;
  content: string;
}

const { title, subtitle, content } = Astro.props;
---

<section style="padding: 2rem 1rem; max-width: 100%; box-sizing: border-box;">
  <h2 style="font-size: 2rem; margin-bottom: 1rem;">{title}</h2>
  <p style="font-size: 1rem; margin-bottom: 1rem;">{subtitle}</p>
  <p style="font-size: 1rem; margin-bottom: 1rem;">{content}</p>
</section> 