---
import Hero from '../components/hero/hero.astro';
import ImageCard from '../components/imageCard/imageCard.astro';
import Layout from './layout.astro';

const {title, subtitle, heroComponent, imageCardComponent} = Astro.props.frontmatter;
--- 

<Layout title={title} subtitle={subtitle}>
    <Hero bookshop:live {...heroComponent} />
    <ImageCard bookshop:live {...imageCardComponent} />
</Layout>